# Provedor: openrouteservice ou google (Google Routes API)
MAPS_PROVIDER=openrouteservice
# Chave do provedor escolhido. Nunca publique o arquivo .env.
MAPS_API_KEY=

# Regra de cobrança do motoboy
DELIVERY_BASE_FEE=5
DELIVERY_PRICE_PER_KM=2

# Origem usada no cálculo da rota
FARMACIA_CEP=
FARMACIA_ENDERECO=
FARMACIA_NUMERO=
FARMACIA_BAIRRO=
FARMACIA_CIDADE=
FARMACIA_UF=
# MongoDB local (padrão do aplicativo)
DB_LOCAL_URI=mongodb://127.0.0.1:27017/crisoneldb
# DB_ATLAS_URI= (opcional, somente se usar Atlas)
# DEFAULT_ADMIN_PASSWORD= (opcional)
# DEFAULT_USER_PASSWORD= (opcional)
